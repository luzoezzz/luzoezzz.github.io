<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>3D Racing Game</title>

<style>
body{
    margin:0;
    overflow:hidden;
}
#speed{
    position:absolute;
    top:10px;
    left:10px;
    color:white;
    font-size:24px;
    font-family:Arial;
}
</style>

<script src="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js"></script>
</head>

<body>

<div id="speed">Speed: 0</div>

<script>

const scene = new THREE.Scene();
scene.background = new THREE.Color(0x87ceeb);

const camera = new THREE.PerspectiveCamera(
75,
window.innerWidth/window.innerHeight,
0.1,
1000
);

const renderer = new THREE.WebGLRenderer({antialias:true});
renderer.setSize(window.innerWidth,window.innerHeight);
document.body.appendChild(renderer.domElement);

// 光照
const sun = new THREE.DirectionalLight(0xffffff,2);
sun.position.set(10,20,10);
scene.add(sun);

scene.add(new THREE.AmbientLight(0xffffff,1));

// 地面
const road = new THREE.Mesh(
new THREE.PlaneGeometry(20,2000),
new THREE.MeshStandardMaterial({color:0x333333})
);

road.rotation.x = -Math.PI/2;
scene.add(road);

// 赛道线
for(let i=0;i<200;i++){

    const line = new THREE.Mesh(
        new THREE.BoxGeometry(0.5,0.05,5),
        new THREE.MeshStandardMaterial({color:0xffffff})
    );

    line.position.z = -i*10;
    scene.add(line);
}

// 赛车
const car = new THREE.Group();

const body = new THREE.Mesh(
new THREE.BoxGeometry(2,1,4),
new THREE.MeshStandardMaterial({color:0xff0000})
);

body.position.y = 0.5;

car.add(body);

scene.add(car);

car.position.y = 0.5;

// 控制
const keys = {};

window.addEventListener("keydown",(e)=>{
keys[e.key.toLowerCase()] = true;
});

window.addEventListener("keyup",(e)=>{
keys[e.key.toLowerCase()] = false;
});

let speed = 0;
let angle = 0;

function updateCar(){

    if(keys["w"])
        speed += 0.01;

    if(keys["s"])
        speed -= 0.01;

    speed *= 0.98;

    if(speed > 1) speed = 1;
    if(speed < -0.5) speed = -0.5;

    if(keys["a"])
        angle += 0.03;

    if(keys["d"])
        angle -= 0.03;

    car.rotation.y = angle;

    car.position.x += Math.sin(angle) * speed;
    car.position.z += Math.cos(angle) * speed;

    document.getElementById("speed")
        .innerText = "Speed: " + Math.floor(speed*300);
}

// 摄像机跟随
function updateCamera(){

    camera.position.x =
        car.position.x - Math.sin(angle)*10;

    camera.position.y = 5;

    camera.position.z =
        car.position.z - Math.cos(angle)*10;

    camera.lookAt(car.position);
}

// 游戏循环
function animate(){

    requestAnimationFrame(animate);

    updateCar();
    updateCamera();

    renderer.render(scene,camera);
}

animate();

</script>

</body>
</html>
